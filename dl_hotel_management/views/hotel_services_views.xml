<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequências para Serviços -->
    <record id="seq_hotel_laundry" model="ir.sequence">
        <field name="name">Sequência de Lavanderia</field>
        <field name="code">hotel.laundry.order.seq</field>
        <field name="prefix">LND/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_hotel_restaurant" model="ir.sequence">
        <field name="name">Sequência de Restaurante</field>
        <field name="code">hotel.restaurant.order.seq</field>
        <field name="prefix">RST/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_hotel_transport" model="ir.sequence">
        <field name="name">Sequência de Transporte</field>
        <field name="code">hotel.transport.request.seq</field>
        <field name="prefix">TRN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ==================== LAVANDERIA ==================== -->
    <record id="view_laundry_tree" model="ir.ui.view">
        <field name="name">hotel.laundry.tree</field>
        <field name="model">hotel.laundry.order</field>
        <field name="arch" type="xml">
            <tree string="Lavanderia">
                <field name="name"/>
                <field name="room_id"/>
                <field name="date"/>
                <field name="status" widget="badge" decoration-success="status=='delivered'"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_laundry_form" model="ir.ui.view">
        <field name="name">hotel.laundry.form</field>
        <field name="model">hotel.laundry.order</field>
        <field name="arch" type="xml">
            <form string="Lavanderia">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_pickup" string="Recolher" type="object" class="oe_highlight" invisible="status != 'confirmed'"/>
                    <button name="action_process" string="Processar" type="object" class="oe_highlight" invisible="status != 'pickup'"/>
                    <button name="action_deliver" string="Entregar" type="object" class="oe_highlight" invisible="status != 'in_process'"/>
                    <button name="action_print_lavandaria" string="Imprimir" type="object" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,pickup,in_process,delivered" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_id" readonly="1" force_save="1"/>
                            <field name="booking_id" readonly="status != 'draft'"/>
                            <field name="date" readonly="status != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Itens">
                            <field name="line_ids" readonly="status != 'draft'">
                                <tree editable="bottom">
                                    <field name="servico_id"/>
                                    <field name="qty"/>
                                    <field name="price"/>
                                    <field name="tax_id"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" widget="monetary" string="Subtotal"/>
                                <field name="total_imposto" widget="monetary" string="Imposto"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="total_geral"/>
                                </div>
                                <field name="total_geral" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== RESTAURANTE ==================== -->
    <record id="view_restaurant_tree" model="ir.ui.view">
        <field name="name">hotel.restaurant.tree</field>
        <field name="model">hotel.restaurant.order</field>
        <field name="arch" type="xml">
            <tree string="Restaurante">
                <field name="name"/>
                <field name="room_id"/>
                <field name="date"/>
                <field name="status" widget="badge" decoration-success="status=='delivered'"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <record id="view_restaurant_form" model="ir.ui.view">
        <field name="name">hotel.restaurant.form</field>
        <field name="model">hotel.restaurant.order</field>
        <field name="arch" type="xml">
            <form string="Restaurante">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_in_prep" string="Preparar" type="object" class="oe_highlight" invisible="status != 'confirmed'"/>
                    <button name="action_deliver" string="Entregar" type="object" class="oe_highlight" invisible="status != 'in_prep'"/>
                    <button name="action_print_restaurante" string="Imprimir" type="object" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,in_prep,delivered" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_id" readonly="1" force_save="1"/>
                            <field name="booking_id" readonly="status != 'draft'"/>
                            <field name="date" readonly="status != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Itens">
                            <field name="line_ids" readonly="status != 'draft'">
                                <tree editable="bottom">
                                    <field name="servico_id"/>
                                    <field name="qty"/>
                                    <field name="price"/>
                                    <field name="tax_id"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_amount" widget="monetary" string="Subtotal"/>
                                <field name="total_imposto" widget="monetary" string="Imposto"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="total_geral"/>
                                </div>
                                <field name="total_geral" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== TRANSPORTE ==================== -->
    <record id="view_transport_tree" model="ir.ui.view">
        <field name="name">hotel.transport.tree</field>
        <field name="model">hotel.transport.request</field>
        <field name="arch" type="xml">
            <tree string="Transporte">
                <field name="name"/>
                <field name="booking_id"/>
                <field name="room_id"/>
                <field name="guest_name"/>
                <field name="servico_id"/>
                <field name="tipo_trajeto"/>
                <field name="data_hora_viagem"/>
                <field name="status" widget="badge" decoration-success="status=='completed'"/>
                <field name="total_geral" string="Total" widget="monetary"/>
            </tree>
        </field>
    </record>

    <record id="view_transport_form" model="ir.ui.view">
        <field name="name">hotel.transport.form</field>
        <field name="model">hotel.transport.request</field>
        <field name="arch" type="xml">
            <form string="Transporte">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_in_progress" string="Iniciar Viagem" type="object" class="oe_highlight" invisible="status != 'confirmed'"/>
                    <button name="action_complete" string="Concluir" type="object" class="oe_highlight" invisible="status != 'in_progress'"/>
                    <button name="action_print_transporte" string="Imprimir" type="object" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Associação à Reserva">
                        <group>
                            <field name="booking_id" readonly="status != 'draft'"/>
                            <field name="room_id" readonly="1" force_save="1"/>
                            <field name="guest_name" readonly="status != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Detalhes da Viagem">
                        <group>
                            <field name="servico_id" readonly="status != 'draft'"/>
                            <field name="tipo_trajeto" readonly="status != 'draft'"/>
                            <field name="local_origem" readonly="status != 'draft'"/>
                            <field name="local_destino" readonly="status != 'draft'"/>
                        </group>
                        <group>
                            <field name="data_hora_viagem" readonly="status != 'draft'"/>
                            <field name="num_passageiros" readonly="status != 'draft'"/>
                            <field name="notas_voo" readonly="status != 'draft'"/>
                        </group>
                    </group>
                    <group string="Valores do Serviço">
                        <group>
                            <field name="preco_base" readonly="status != 'draft'"/>
                            <field name="imposto_id" readonly="status != 'draft'"/>
                        </group>
                        <group class="oe_subtotal_footer oe_right">
                            <field name="subtotal" widget="monetary" string="Subtotal" force_save="1"/>
                            <field name="imposto" widget="monetary" string="Imposto" force_save="1"/>
                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="total_geral"/>
                            </div>
                            <field name="total_geral" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== FOLIOS (Faturas) ==================== -->
    <record id="view_folio_tree" model="ir.ui.view">
        <field name="name">hotel.folio.tree</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <tree string="Folios">
                <field name="name"/>
                <field name="booking_id"/>
                <field name="partner_id"/>
                <field name="status" widget="badge" decoration-success="status=='closed'"/>
                <field name="grand_total"/>
            </tree>
        </field>
    </record>

    <record id="view_folio_form" model="ir.ui.view">
        <field name="name">hotel.folio.form</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <form string="Folio">
                <header>
                    <button name="action_create_invoice" string="Emitir Fatura Certificada" type="object" class="oe_highlight" invisible="status == 'closed' or invoice_id"/>
                    <field name="status" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Fatura Odoo</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="booking_id"/>
                            <field name="partner_id"/>
                            <field name="invoice_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Serviços de Lavanderia" name="laundry">
                            <field name="laundry_order_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="status"/>
                                    <field name="total_amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Consumos de Restaurante" name="restaurant">
                            <field name="restaurant_order_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="status"/>
                                    <field name="total_amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Serviço de Transporte" name="transport">
                            <field name="transport_request_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="servico_id"/>
                                    <field name="tipo_trajeto"/>
                                    <field name="status"/>
                                    <field name="total_geral" string="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Consumos de Ponto de Venda (POS)" name="pos_orders">
                            <field name="pos_order_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date_order"/>
                                    <field name="amount_total" sum="Total POS"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="room_charge_total"/>
                                <field name="grand_total" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Ações e Menus -->
    <record id="action_laundry" model="ir.actions.act_window"><field name="name">Pedidos de Lavanderia</field><field name="res_model">hotel.laundry.order</field><field name="view_mode">tree,form</field></record>
    <record id="action_restaurant" model="ir.actions.act_window"><field name="name">Pedidos de Restaurante</field><field name="res_model">hotel.restaurant.order</field><field name="view_mode">tree,form</field></record>
    <record id="action_transport" model="ir.actions.act_window"><field name="name">Pedidos de Transporte</field><field name="res_model">hotel.transport.request</field><field name="view_mode">tree,form</field></record>
    <record id="action_folio" model="ir.actions.act_window"><field name="name">Folios de Hóspedes</field><field name="res_model">hotel.folio</field><field name="view_mode">tree,form</field></record>

    <!-- Serviços de Lavandaria -->
    <record id="view_lavanderia_servico_tree" model="ir.ui.view">
        <field name="name">hotel.lavanderia.servico.tree</field>
        <field name="model">hotel.lavanderia.servico</field>
        <field name="arch" type="xml">
            <tree string="Serviços de Lavandaria" editable="bottom">
                <field name="name"/>
                <field name="preco"/>
