    <record id="view_transporte_servico_form" model="ir.ui.view">
        <field name="name">hotel.transporte.servico.form</field>
        <field name="model">hotel.transporte.servico</field>
        <field name="arch" type="xml">
            <form string="Serviço de Transporte">
                <sheet>
