        <field name="res_model">hotel.transporte.servico</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_laundry_orders" name="Pedidos" parent="menu_hotel_laundry" action="action_laundry" sequence="1" groups="dl_hotel_management.group_hotel_recepcao,dl_hotel_management.group_hotel_manager"/>
    <menuitem id="menu_laundry_services" name="Serviços de Lavandaria" parent="menu_hotel_laundry" action="action_lavanderia_servico" sequence="10" groups="dl_hotel_management.group_hotel_manager"/>
    <menuitem id="menu_restaurant_orders" name="Pedidos" parent="menu_hotel_restaurant" action="action_restaurant" sequence="1" groups="dl_hotel_management.group_hotel_recepcao,dl_hotel_management.group_hotel_manager"/>
    <menuitem id="menu_restaurant_services" name="Serviços do Restaurante" parent="menu_hotel_restaurant" action="action_restaurante_servico" sequence="10" groups="dl_hotel_management.group_hotel_manager"/>
    <menuitem id="menu_transport_orders" name="Pedidos" parent="menu_hotel_transport" action="action_transport" sequence="1" groups="dl_hotel_management.group_hotel_recepcao,dl_hotel_management.group_hotel_manager"/>
    <menuitem id="menu_transport_services" name="Serviços de Transporte" parent="menu_hotel_transport" action="action_transporte_servico" sequence="10" groups="dl_hotel_management.group_hotel_manager"/>
    <menuitem id="menu_folios_orders" name="Todos os Folios" parent="menu_hotel_folios" action="action_folio" sequence="1" groups="dl_hotel_management.group_hotel_recepcao,dl_hotel_management.group_hotel_manager"/>

</odoo>