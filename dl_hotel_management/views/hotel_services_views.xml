                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lavanderia_servico" model="ir.actions.act_window">
        <field name="name">Serviços de Lavandaria</field>
        <field name="res_model">hotel.lavanderia.servico</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Serviços do Restaurante -->
    <record id="view_restaurante_servico_tree" model="ir.ui.view">
