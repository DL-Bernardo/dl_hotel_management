            </tree>
        </field>
    </record>

    <record id="view_lavanderia_servico_form" model="ir.ui.view">
        <field name="name">hotel.lavanderia.servico.form</field>
        <field name="model">hotel.lavanderia.servico</field>
        <field name="arch" type="xml">
            <form string="Serviço de Lavandaria">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="preco"/>
