    <record id="action_restaurante_servico" model="ir.actions.act_window">
        <field name="name">Serviços do Restaurante</field>
        <field name="res_model">hotel.restaurante.servico</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Serviços de Transporte -->
    <record id="view_transporte_servico_tree" model="ir.ui.view">
        <field name="name">hotel.transporte.servico.tree</field>
        <field name="model">hotel.transporte.servico</field>
        <field name="arch" type="xml">
            <tree string="Serviços de Transporte" editable="bottom">
