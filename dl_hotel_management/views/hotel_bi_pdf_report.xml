    <!-- ==================== TEMPLATE BASE (LAYOUT & ESTILOS) ==================== -->
    
    <template id="report_bi_styles">
        <style>
            .bi-title {
                font-family: 'Montserrat', sans-serif;
                font-size: 22px;
                font-weight: 700;
                color: #1a252f;
                border-bottom: 2px solid #1f6c98;
                padding-bottom: 8px;
                margin-bottom: 25px;
                text-transform: uppercase;
            }
            .metadata-card {
                background-color: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 6px;
                padding: 15px;
                margin-bottom: 25px;
                font-size: 13px;
            }
            .metadata-card table {
                width: 100%;
                margin: 0;
            }
            .metadata-card th {
                color: #64748b;
                font-weight: 600;
                width: 20%;
                padding: 3px 0;
            }
            .metadata-card td {
                color: #1e293b;
                padding: 3px 0;
            }
            .bi-table th {
                background-color: #34495e;
                color: #ffffff;
                font-weight: bold;
                text-transform: uppercase;
                font-size: 11px;
                padding: 8px !important;
            }
            .bi-table td {
                vertical-align: middle;
                padding: 8px !important;
                font-size: 13px;
            }
            .total-row {
                background-color: #1f6c98 !important;
                color: #ffffff !important;
                font-weight: bold;
            }
            .total-row td {
                font-size: 13px;
                border-top: 2px solid #1f6c98 !important;
            }
        </style>
    </template>

    <!-- ==================== TEMPLATE OCUPAÇÃO ==================== -->
    <template id="report_bi_ocupacao_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="dl_hotel_management.report_bi_styles"/>
                <div class="page">
                    <!-- Título -->
                    <div class="row">
                        <div class="col-12">
                            <h2 class="bi-title">RELATÓRIO MENSAL DE ANÁLISE - OCUPAÇÃO &amp; ALOJAMENTO</h2>
                        </div>
                    </div>

                    <!-- Metadados -->
                    <div class="metadata-card">
                        <table>
                            <tr>
                                <th>Área Analisada:</th>
                                <td><span t-esc="area"/></td>
                                <th>Data de Emissão:</th>
                                <td><span t-esc="date_emission" t-options='{"widget": "date"}'/></td>
                            </tr>
                            <tr>
                                <th>Gerado por:</th>
                                <td><span t-esc="user.name"/></td>
                                <th>Filtros Aplicados:</th>
                                <td>Filtros de Período Ativos no Ecrã</td>
                            </tr>
                        </table>
                    </div>

                    <!-- Tabela de Dados -->
                    <table class="table table-bordered bi-table">
                        <thead>
                            <tr>
                                <th>Quarto</th>
                                <th class="text-end">Noites Reservadas</th>
                                <th class="text-end">Faturação Acumulada</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_noites" t-value="0"/>
                            <t t-set="total_faturado" t-value="0.0"/>
                            <tr t-foreach="report_data" t-as="row">
                                <td><span t-esc="row['quarto']"/></td>
                                <td class="text-end"><span t-esc="row['noites']"/></td>
                                <td class="text-end">
                                    <span t-esc="row['faturado']" t-options='{"widget": "monetary", "display_currency": user.company_id.currency_id}'/>
                                </td>
                                <t t-set="total_noites" t-value="total_noites + row['noites']"/>
                                <t t-set="total_faturado" t-value="total_faturado + row['faturado']"/>
                            </tr>
                            <!-- Totais -->
                            <tr class="total-row">
                                <td>TOTAL ACUMULADO</td>
                                <td class="text-end"><span t-esc="total_noites"/></td>
                                <td class="text-end">
                                    <span t-esc="total_faturado" t-options='{"widget": "monetary", "display_currency": user.company_id.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

