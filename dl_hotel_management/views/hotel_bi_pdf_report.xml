    <!-- Server Actions for Printing BI Reports (Aparece no botão Ações das vistas pivot/graph) -->
    <record id="action_server_print_bi_ocupacao" model="ir.actions.server">
        <field name="name">Imprimir PDF</field>
        <field name="model_id" ref="model_hotel_booking"/>
        <field name="binding_model_id" ref="model_hotel_booking"/>
        <field name="binding_view_types">pivot,list,graph</field>
        <field name="state">code</field>
        <field name="code">
            action = record.action_print_bi_report()
        </field>
    </record>

