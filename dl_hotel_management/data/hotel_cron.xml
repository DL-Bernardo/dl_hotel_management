<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job to update room statuses based on today's bookings -->
        <record id="ir_cron_update_room_statuses" model="ir.cron">
            <field name="name">Hotel: Atualizar Status dos Quartos</field>
            <field name="model_id" ref="model_hotel_room"/>
            <field name="state">code</field>
            <field name="code">model.action_update_room_statuses()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Job to automatically check-in confirmed bookings that reached check-in time -->
        <record id="ir_cron_auto_checkin" model="ir.cron">
            <field name="name">Hotel: Auto Check-In de Reservas</field>
            <field name="model_id" ref="model_hotel_booking"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_checkin()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>